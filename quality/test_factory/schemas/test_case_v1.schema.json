{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:father:test-factory:test-case:1.0.0",
  "title":"FATHER TestCaseV1",
  "type":"object", "additionalProperties":false,
  "required":["case_id","schema_version","status","system","objective","requirement_ids","contract_ids","threat_ids","source_refs","preconditions","setup","steps","negative_assertions","evidence_plan","expected_result","review"],
  "properties":{
    "case_id":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]{5,63}$"},
    "schema_version":{"const":"1.0.0"},
    "status":{"enum":["DESIGN","REVIEWED","APPROVED","EXECUTED","QUALIFIED"]},
    "system":{"type":"string","minLength":2,"maxLength":100},
    "objective":{"type":"string","minLength":30,"maxLength":1200},
    "requirement_ids":{"$ref":"#/$defs/ids"},
    "contract_ids":{"$ref":"#/$defs/ids"},
    "threat_ids":{"$ref":"#/$defs/ids"},
    "source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["source_id","locator","application_note"],"properties":{"source_id":{"type":"string","minLength":4},"locator":{"type":"string","minLength":3},"application_note":{"type":"string","minLength":10}}}},
    "preconditions":{"$ref":"#/$defs/statements"},
    "setup":{"$ref":"#/$defs/statements"},
    "steps":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["step_id","stimulus","expected","observables"],"properties":{"step_id":{"type":"string","pattern":"^S-[0-9]{2,3}$"},"stimulus":{"type":"string","minLength":8},"expected":{"type":"string","minLength":8},"observables":{"$ref":"#/$defs/statements"}}}},
    "negative_assertions":{"$ref":"#/$defs/statements"},
    "evidence_plan":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["kind","description","hash_required"],"properties":{"kind":{"enum":["HTTP","DB_STATE","AUDIT","TOOL_COUNTER","TRACE","RUN_MANIFEST","METRICS","SOURCE_DIGEST"]},"description":{"type":"string","minLength":10},"hash_required":{"const":true}}}},
    "expected_result":{"type":"string","minLength":25},
    "review":{"type":"object","additionalProperties":false,"required":["owner","status"],"properties":{"owner":{"type":"string","minLength":3},"status":{"enum":["PENDING","APPROVED"]}}}
  },
  "$defs":{
    "ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":3}},
    "statements":{"type":"array","minItems":1,"items":{"type":"string","minLength":8}}
  }
}
